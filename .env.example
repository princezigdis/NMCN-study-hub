# ---------------------------------------------------------------
# FRONTEND (.env.local) — these are PUBLIC values, safe in the browser.
# Find them in Supabase Dashboard → Project Settings → API.
# ---------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_APP_NAME=NMCN Study

# ---------------------------------------------------------------
# SERVER SECRETS — NEVER put these in .env.local or any VITE_ variable.
# Set them as Edge Function secrets:
#   supabase secrets set ANTHROPIC_API_KEY=... OPENAI_API_KEY=... (etc.)
# For local `supabase functions serve`, copy to supabase/.env.local (git-ignored).
# ---------------------------------------------------------------
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are provided to
# Edge Functions automatically by Supabase.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=            # image generation (and optional text fallback)
# YOUTUBE_API_KEY=           # YouTube Data API v3 (video search)
# PAYSTACK_SECRET_KEY=       # sk_test_... first; sk_live_... only after go-live checks
# APP_URL=https://your-app-domain.com
# ALLOWED_ORIGINS=https://your-app-domain.com,http://localhost:5173
